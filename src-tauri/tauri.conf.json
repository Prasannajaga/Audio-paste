{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "audio-paste",
  "version": "0.1.0",
  "identifier": "com.audio.paste",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Paste",
        "width": 700,
        "height": 400,
        "minWidth": 600,
        "minHeight": 350,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "resources": [
      "whisper.cpp/build/bin/whisper-cli",
      "whisper.cpp/build/src/libwhisper.so.1",
      "whisper.cpp/build/ggml/src/libggml.so.0",
      "whisper.cpp/build/ggml/src/libggml-base.so.0",
      "whisper.cpp/build/ggml/src/libggml-cpu.so.0"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
